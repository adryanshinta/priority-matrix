# ==========================================
# ENVIRONMENT CONFIGURATION
# ⚠️ JANGAN isi nilai asli di file ini — file ini ditrack git!
# Copy ke .env (yang di-gitignore), isi di sana, lalu kosongkan file ini.
# ==========================================

# Mode aplikasi: development | production
NODE_ENV=development

# Port untuk Express backend
PORT=3000

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Boleh menyertakan ?sslmode=require — parameter SSL dinormalkan otomatis
# oleh server/db/connection.js (lihat catatan di file tersebut).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/prioritymatrix

# ==========================================
# JWT SECRETS (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ==========================================
JWT_ACCESS_SECRET=generate_random_hex_32_bytes_disini
JWT_REFRESH_SECRET=generate_random_hex_32_bytes_disini

# ==========================================
# GOOGLE OAUTH (dari Google Cloud Console)
# ==========================================
GOOGLE_CLIENT_ID=your_client_id_disini.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_disini
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ==========================================
# CLIENT URL (origin frontend)
# Dev: http://localhost:5173
# Vercel prod: https://NAMA-PROYEK.vercel.app
# ==========================================
CLIENT_URL=http://localhost:5173

# ==========================================
# VERCEL (Production serverless)
# Set di dashboard Vercel (Environment Variables), BUKAN di .env lokal.
# Vercel otomatis set VERCEL=1. Sediakan URL callback prod:
# GOOGLE_REDIRECT_URI=https://NAMA-PROYEK.vercel.app/api/auth/google/callback
# ==========================================